# Copiez ce fichier en .env (ou .env.production) et adaptez les valeurs.
# Ce fichier NE contient aucun identifiant réel : il sert de modèle.

NODE_ENV=development

# Base de données MySQL
DB_HOST=localhost
DB_USER=votre_utilisateur_mysql
DB_PASSWORD=votre_mot_de_passe_mysql
DB_NAME=magasin_it
DB_PORT=3306

# Ports applicatifs
API_PORT=3001
CLIENT_PORT=5173
